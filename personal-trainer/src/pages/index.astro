---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import CategoryCards from "../components/home/CategoryCards.astro";
import Hero from "../components/home/Hero.astro";
import RecentBlogPosts from "../components/home/RecentBlogPosts.astro";
import TransformationSlider from "../components/home/TransformationSlider.jsx";
import BaseLayout from "../layouts/BaseLayout.astro";

import afterOne from "../assets/after_one.png";
import afterThree from "../assets/after_three.png";
import afterTwo from "../assets/after_two.png";
import beforeOne from "../assets/before_one.png";
import beforeThree from "../assets/before_three.png";
import beforeTwo from "../assets/before_two.png";

// The slider is at most 896px wide (max-w-4xl) and each photo fills about half
// of it on desktop or the full width on mobile, so 880px is enough. The raw
// .src would send the original PNGs (200–430 KB each) to the browser.
async function optimise(image: ImageMetadata) {
  const result = await getImage({
    src: image,
    width: Math.min(image.width, 880),
    format: "webp",
  });
  return {
    src: result.src,
    width: Number(result.attributes.width),
    height: Number(result.attributes.height),
  };
}

const [b1, a1, b2, a2, b3, a3] = await Promise.all(
  [beforeOne, afterOne, beforeTwo, afterTwo, beforeThree, afterThree].map(
    optimise,
  ),
);

const slides = [
  {
    before: b1.src,
    beforeWidth: b1.width,
    beforeHeight: b1.height,
    after: a1.src,
    afterWidth: a1.width,
    afterHeight: a1.height,
    quote:
      "I never thought I could enjoy the gym. George's program changed everything — I'm stronger and more confident than ever.",
    name: "John Smith",
    result: "Lost 15 kg",
  },
  {
    before: b2.src,
    beforeWidth: b2.width,
    beforeHeight: b2.height,
    after: a2.src,
    afterWidth: a2.width,
    afterHeight: a2.height,
    quote:
      "I gained muscle without living in the gym. The programming is smart, efficient, and actually sustainable.",
    name: "David Mereth",
    result: "Lost 35 kg",
  },
  {
    before: b3.src,
    beforeWidth: b3.width,
    beforeHeight: b3.height,
    after: a3.src,
    afterWidth: a3.width,
    afterHeight: a3.height,
    quote:
      "The nutrition plan was simple to follow and the results spoke for themselves. Best investment I've made in myself.",
    name: "Maria Lopez",
    result: "Lost 8 kg muscle",
  },
];
---

<BaseLayout
  title="George Stevens — Personal Trainer"
  description="Science-based training and nutrition programs to transform your body."
>
  <main>
    <Hero />
    <CategoryCards />

    <section class="mx-auto max-w-7xl px-6 py-20 md:py-28">
      <h2
        class="mb-12 text-center font-heading text-4xl tracking-wider text-white md:text-5xl"
      >
        CLIENT TRANSFORMATIONS
      </h2>
      <TransformationSlider client:visible slides={slides} />
    </section>

    <RecentBlogPosts />
  </main>
</BaseLayout>
